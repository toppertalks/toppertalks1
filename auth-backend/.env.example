# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/toppertalks?retryWrites=true&w=majority

# JWT secrets
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here

# Token lifetimes
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cookie settings
COOKIE_NAME=refreshToken
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=csrfToken
CSRF_HEADER_NAME=x-csrf-token
CSRF_ENFORCE=false
ENFORCE_HTTPS=false
TRUST_PROXY=false

# Server
PORT=5000
FRONTEND_URL=http://localhost:3000

# Email settings (replace with your email provider credentials)
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-email-password
EMAIL_FROM="TopperTalks Support" <support@toppertalks.com>
